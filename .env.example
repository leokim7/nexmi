# 진단 입력은 저장하지 않는다. 공유 카드·한마디만 DB 에 저장한다.
# Railway 는 PORT 를 자동으로 주입한다.
PORT=8000
# 선택: 빌드된 프런트엔드 위치 (기본값: frontend/dist)
# FRONTEND_DIST=/app/frontend/dist
# Railway PostgreSQL. 비우면 backend/nexmi-local.db (SQLite) 사용 — 운영에서는 반드시 설정
# DATABASE_URL=postgresql://...
# 익명 사용자 구분용 해시 소금, 관리자 삭제 토큰
# HASH_SALT=
# ADMIN_TOKEN=
